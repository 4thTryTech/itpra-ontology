# CQ14 (part 2) — does any named graph hold a triple with a blank-node subject or object?
#
# ASK query, iterating every named graph explicitly (`GRAPH ?g`) rather than relying on
# use_default_graph_as_union. Expected: False — emit.py mints no blank nodes.

ASK {
  GRAPH ?g {
    ?s ?p ?o .
    FILTER(isBlank(?s) || isBlank(?o))
  }
}
