# Positive control for cq-12: total skos:altLabel triples in t1. test_competency.py asserts
# this equals the number of aliases across every term record, computed straight from the YAML.

PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT (COUNT(*) AS ?n)
WHERE {
  GRAPH itpra-g:t1 {
    ?s skos:altLabel ?label .
  }
}
