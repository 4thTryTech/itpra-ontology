# CQ5 (part 3) — registry violations: an NFR `categorizedAs` (qa) target that is NOT typed
# QUALITY_ATTRIBUTE in t1.
#
# Reads every req/<X> graph (matched by name prefix). Expected to be EMPTY; test_competency.py
# asserts that.

SELECT ?req ?target
WHERE {
  GRAPH ?g {
    ?req itpra-o:categorizedAs ?target .
  }
  FILTER(STRSTARTS(STR(?g), CONCAT(STR(itpra-g:), "req/")))
  FILTER NOT EXISTS {
    GRAPH itpra-g:t1 { ?target a itpra:QUALITY_ATTRIBUTE }
  }
}
