# CQ7 (part 1) — every (capability, requirement) pair the rule-derived itpra-o:meets edge holds.
#
# test_competency.py compares this set, reversed to (requirement, capability), against cq-11's
# authored metBy pairs: `meets` must be exactly the inverse of `metBy` (ADR 0041 D4's one allowed
# materialised reverse link).

SELECT ?cap ?req
WHERE {
  GRAPH itpra-g:inferred {
    ?cap itpra-o:meets ?req .
  }
}
