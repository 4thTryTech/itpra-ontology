# CQ8 (part 1) — requirements with no `metBy` edge at all, across every req/<X> graph.
#
# The consumer's traceability rule (ADR 0042 D7) requires every requirement to be met by at least one
# capability; the LinkML authoring shape enforces
# `minimum_cardinality: 1` already, so this graph-level check is expected to be EMPTY — a second,
# independent confirmation at the RDF layer.

SELECT ?req
WHERE {
  GRAPH ?g {
    ?req a itpra:REQUIREMENT .
    FILTER NOT EXISTS { ?req itpra-o:metBy ?cap }
  }
  FILTER(STRSTARTS(STR(?g), CONCAT(STR(itpra-g:), "req/")))
}
