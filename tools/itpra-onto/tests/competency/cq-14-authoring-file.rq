# CQ8 — every subject in t1, with a count of its distinct itpra-o:authoringFile values
# and one sample value.
#
# test_competency.py asserts every count is exactly 1 (ADR 0043 D3) and that the sampled file exists
# relative to the repository root.

SELECT ?s (COUNT(DISTINCT ?file) AS ?n) (SAMPLE(?file) AS ?sample)
WHERE {
  GRAPH itpra-g:t1 {
    ?s itpra-o:authoringFile ?file .
  }
}
GROUP BY ?s
