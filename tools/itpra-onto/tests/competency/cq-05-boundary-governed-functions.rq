# CQ4 — the boundary-governed function set materialised by the rules (itpra-o:BoundaryGovernedFunction).
#
# test_competency.py compares this set against the one computed from the YAML, not just its size.

SELECT ?func
WHERE {
  GRAPH itpra-g:inferred {
    ?func a itpra-o:BoundaryGovernedFunction .
  }
}
