# CQ13 (part 3) — every schema-graph term (property or class) declared with an rdfs:comment that
# starts "derived by rule" — the rule-derived vocabulary emit.py declares up front so a
# consumer can discover it without running the rules.
#
# test_competency.py uses this set as the allow-list for cq-23's predicates and cq-24's types.

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?term ?comment
WHERE {
  GRAPH itpra-g:schema {
    ?term rdfs:comment ?comment .
    FILTER(STRSTARTS(STR(?comment), "derived by rule"))
  }
}
