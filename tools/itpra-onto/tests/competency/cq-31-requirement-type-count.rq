# Positive control for cq-12/cq-13: total itpra:REQUIREMENT-typed subjects across every
# req/<X> graph. Both cq-12 (no metBy) and cq-13 (no verifiedBy) select `?req a itpra:REQUIREMENT`; if
# that class were ever misspelled, both queries would trivially return EMPTY regardless of the real data.
# test_competency.py asserts this count equals the total number of registry records.

SELECT (COUNT(*) AS ?n)
WHERE {
  GRAPH ?g {
    ?req a itpra:REQUIREMENT .
  }
  FILTER(STRSTARTS(STR(?g), CONCAT(STR(itpra-g:), "req/")))
}
