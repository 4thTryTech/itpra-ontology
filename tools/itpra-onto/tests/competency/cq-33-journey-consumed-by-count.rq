# Positive control for cq-16: total itpra-o:consumedBy edges whose subject is typed
# itpra:JOURNEY, in t1. test_competency.py asserts this equals the `consumed_by` edge count computed from
# every Journey record's `relates_to` list.

SELECT (COUNT(*) AS ?n)
WHERE {
  GRAPH itpra-g:t1 {
    ?journey a itpra:JOURNEY ;
             itpra-o:consumedBy ?persona .
  }
}
