# CQ5 (part 1) — registry violations: a `metBy` target that is NOT typed CAPABILITY in t1.
#
# Reads every req/<X> graph (matched by name prefix, not enumerated, so a new registry is covered
# automatically). Expected to be EMPTY; test_competency.py asserts that.

SELECT ?req ?target
WHERE {
  GRAPH ?g {
    ?req itpra-o:metBy ?target .
  }
  FILTER(STRSTARTS(STR(?g), CONCAT(STR(itpra-g:), "req/")))
  FILTER NOT EXISTS {
    GRAPH itpra-g:t1 { ?target a itpra:CAPABILITY }
  }
}
