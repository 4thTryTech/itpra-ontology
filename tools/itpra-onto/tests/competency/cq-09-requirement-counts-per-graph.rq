# CQ6 — FR / NFR counts per req/<X> graph.
#
# One row per (graph, class, count); test_competency.py compares each to that registry's own
# YAML-computed count and checks the total equals the sum across every registry.

SELECT ?g ?class (COUNT(DISTINCT ?r) AS ?n)
WHERE {
  GRAPH ?g {
    ?r a ?class .
    FILTER(?class = itpra:FR || ?class = itpra:NFR)
  }
  FILTER(STRSTARTS(STR(?g), CONCAT(STR(itpra-g:), "req/")))
}
GROUP BY ?g ?class
