# Positive control for cq-07: total itpra-o:verifiedBy edges across every req/<X> graph.
#
# See cq-28's header for why a count-only positive control matters alongside an expected-EMPTY query.
# test_competency.py asserts this equals the number of verified_by entries across every registry.

SELECT (COUNT(*) AS ?n)
WHERE {
  GRAPH ?g {
    ?req itpra-o:verifiedBy ?target .
  }
  FILTER(STRSTARTS(STR(?g), CONCAT(STR(itpra-g:), "req/")))
}
