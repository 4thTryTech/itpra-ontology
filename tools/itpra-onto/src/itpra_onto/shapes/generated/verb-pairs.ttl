                FILTER NOT EXISTS {
                    $this rdf:type ?s .
                    ?value rdf:type ?o .
                    FILTER(
                        (?s = itpra:PERSONA && ?o = itpra:CAPABILITY)
                    )
                }
            }
        """ ;
    ] .

# produces (evidence: meta-only; predicate itpra-o:produces); allowed pairs: none; unresolvable (no record class): (SERVICE, Capability)
