# requirements.ttl -- the `requirements` shape file (shapes/REGISTER.md "Shape files and their fixtures").
# Registry and traceability shapes over `req/*` — mixed SHACL Core and SHACL-SPARQL, domain-scoped rather
# than mechanism-scoped (unlike `structural`/`crossfield`). No `@prefix` for itpra:/itpra-o:/itpra-g: or the
# W3C/DCMI constants -- `itpra_onto.shacl.load_shapes` prepends the standard block at load time (shacl.py's
# module docstring). Every `sh:sparql` node carries `sh:prefixes itpra-o:shapesPrefixes ;` (same doc, point
# (c)) so dcterms:/itpra-o:/itpra: are all resolvable inside the embedded SPARQL text without ever writing
# the base IRI here (ADR 0004).
#
# Six shape-bearing rule ids (shapes/REGISTER.md's `requirements` entry): req-id-format, req-qa-unresolved,
# req-statement-missing, B-4 (all SHACL Core), plus req-target-unresolved and B-1 (both SHACL-SPARQL;
# req-target-unresolved mirrors the linter). B-4 is closed pre-emission by the authoring schema AND is a
# graph shape here (mechanism `generated` + `core`) -- see this file's own B-4 section below and
# fixtures/requirements/README.md for why the pre-emission closure alone left a real gap. B-11 remains
# documented, not shaped -- see fixtures/requirements/README.md.

# ---------------------------------------------------------------------------------------------------
# req-id-format (Table A, A8; Violation, Core) -- one PropertyShape per subclass, since FR and NFR carry
# different id patterns (ADR 0004; schema.yaml id.conventions.requirement_FR/NFR). The exact patterns are
# taken verbatim from schema/itpra.linkml.yaml's own `slot_usage.id.pattern` for FR/NFR (the authoring
# schema's rule text, not invented here; confirmed empirically: matches all 406 FR and all 166 NFR records
# in the live registries, zero exceptions). The consumer's linter applies the SAME two literals (its
# REQ_ID_PATTERNS), per the record's own `type` exactly as these two shapes do per class -- one looser
# shared regex would let an FR id with no ordinal pass the linter and fail here under the same comparable
# rule id. tests/test_parity.py asserts the linter's literals, these sh:pattern literals and the schema's
# are equal.
itpra-o:ReqFrIdFormatShape
    a sh:PropertyShape ;
    sh:targetClass itpra:FR ;
    sh:path dcterms:identifier ;
    sh:pattern "^FR-[A-Z]+-[0-9]+$" ;
    sh:severity sh:Violation ;
    # Core (sh:pattern) violations are NOT message-substituted by pySHACL (bound_vars is only ever passed
    # for SPARQLConstraint evaluation -- confirmed empirically against pyshacl 0.30.x's own source: no Core
    # constraint component passes bound_vars to make_v_result); the finding's own sh:focusNode/sh:value
    # already carry the offending id, so the message names the FIELD, not a `{$value}` placeholder that
    # would render literally unsubstituted.
    sh:message "an itpra:FR's dcterms:identifier does not match FR-<DOMAIN>-<n> (schema/itpra.linkml.yaml FR.slot_usage.id.pattern; ADR 0004)" ;
    itpra-o:ruleId "req-id-format" .

itpra-o:ReqNfrIdFormatShape
    a sh:PropertyShape ;
    sh:targetClass itpra:NFR ;
    sh:path dcterms:identifier ;
    sh:pattern "^NFR-[A-Z][A-Z_]*-[0-9]+$" ;
    sh:severity sh:Violation ;
    sh:message "an itpra:NFR's dcterms:identifier does not match NFR-<QA>-<n> or NFR-<X>_<QA>-<n> (schema/itpra.linkml.yaml NFR.slot_usage.id.pattern; ADR 0004)" ;
    itpra-o:ruleId "req-id-format" .

# ---------------------------------------------------------------------------------------------------
# req-statement-missing (Table A, A12; Violation, Core): exactly one itpra-o:statement on every
# itpra:REQUIREMENT (the shared abstract class both FR and NFR are also typed with -- emit.py's
# `requirement_triples` always asserts `RDF_TYPE vocab.requirement_base` alongside the FR/NFR subclass
# triple). A missing `statement` does not crash emission (REGISTER.md's own note on this row), so a real
# shape is needed, unlike the `generated` (emit-time) rows.
itpra-o:ReqStatementMissingShape
    a sh:PropertyShape ;
    sh:targetClass itpra:REQUIREMENT ;
    sh:path itpra-o:statement ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "a itpra:REQUIREMENT has no (or more than one) itpra-o:statement" ;
    itpra-o:ruleId "req-statement-missing" .

# ---------------------------------------------------------------------------------------------------
# req-qa-unresolved (Table A, A10; Violation, Core): every itpra:NFR has exactly one itpra-o:categorizedAs
# whose object is an itpra:QUALITY_ATTRIBUTE. minCount/maxCount restate NFR.slot_usage.qa's required
# cardinality at the graph level (needed for parity, since the generated authoring SHACL never validates the
# emitted graph -- shapes/REGISTER.md's own framing note); sh:class is the actual QA-resolution check the
# linter performs (`qa not in qa_ids`).
itpra-o:ReqQaUnresolvedShape
    a sh:PropertyShape ;
    sh:targetClass itpra:NFR ;
    sh:path itpra-o:categorizedAs ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class itpra:QUALITY_ATTRIBUTE ;
    sh:severity sh:Violation ;
    sh:message "an itpra:NFR's itpra-o:categorizedAs does not resolve to exactly one itpra:QUALITY_ATTRIBUTE" ;
    itpra-o:ruleId "req-qa-unresolved" .

# ---------------------------------------------------------------------------------------------------
# req-target-unresolved (Table A, A13; Warning per Table C; SHACL-SPARQL). A PARITY REPRODUCTION of the
# linter's own check: the linter warns on a met_by/verified_by reference only when it is neither a defined
# id (`ref in terms or ref in req_ids`) nor an id whose first hyphen-segment is one of INSTANCE_PREFIXES
# (the consumer's linter: CAP/FUNC/SVC/PERSONA/JRN/WF/FR/NFR/ADR/OQ, `ref.split("-")[0]`). The graph form:
# the object carries no rdf:type at all (no record of any kind has that id -- a requirement of another
# registry is typed too, and the linter's prefix fallback accepts FR/NFR ids anyway) AND its local name's
# first segment is not one of those prefixes (`^(PFX)(-|$)` is exactly `split("-")[0] in PFX`).
# tests/test_parity.py asserts the prefix list below equals the linter's INSTANCE_PREFIXES.
#
# No typed shape is filed under this comparable id (the linter never checks a type): typing is B-22's
# business (shapes/generated/verb-pairs.ttl, generated from the met_by/verified_by itpra_verb pairs:
# (FR|NFR, Capability) and (FR|NFR, Journey)), under its own Table B id.
itpra-o:ReqTargetUnresolvedShape
    a sh:NodeShape ;
    sh:targetClass itpra:REQUIREMENT ;
    sh:severity sh:Warning ;
    itpra-o:ruleId "req-target-unresolved" ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "{?path} reference {?value} does not resolve to a defined record and does not start with a known instance prefix (CAP/FUNC/SVC/PERSONA/JRN/WF/FR/NFR/ADR/OQ)" ;
        sh:prefixes itpra-o:shapesPrefixes ;
        sh:select """
            SELECT DISTINCT $this ?path ?value
            WHERE {
                $this ?path ?value .
                FILTER(?path IN (itpra-o:metBy, itpra-o:verifiedBy))
                FILTER NOT EXISTS { ?value rdf:type ?anyType }
                FILTER(!REGEX(STRAFTER(STR(?value), STR(itpra:)), "^(CAP|FUNC|SVC|PERSONA|JRN|WF|FR|NFR|ADR|OQ)(-|$)"))
            }
        """ ;
    ] .

# ---------------------------------------------------------------------------------------------------
# B-1 (Table B; Violation per Table C's B-1 row; SHACL-SPARQL): an NFR id embeds its qa
# (NFR-<QA>-<n> or NFR-<X>_<QA>-<n>; schema.yaml external_registries.requirements.rules, ADR 0004 --
# checked by the RDF shapes, not by the linter). ?qid is the categorizedAs object's own dcterms:identifier;
# ?id is the NFR's own dcterms:identifier. Pattern built with CONCAT so the QA id is never hand-copied into
# a literal regex; QA ids are `[A-Z_]+` (terms/quality-attributes.yaml), so nothing needs escaping
# (confirmed empirically: zero of the 166 live NFR records fire this).
itpra-o:ReqNfrIdEmbedsQaShape
    a sh:NodeShape ;
    sh:targetClass itpra:NFR ;
    sh:severity sh:Violation ;
    itpra-o:ruleId "B-1" ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "NFR id {?id} does not embed its qa {?qid} (ADR 0004: NFR-<QA>-<n> or NFR-<X>_<QA>-<n>)" ;
        sh:prefixes itpra-o:shapesPrefixes ;
        sh:select """
            SELECT DISTINCT $this ?id ?qid
            WHERE {
                $this dcterms:identifier ?id .
                $this itpra-o:categorizedAs ?qa .
                ?qa dcterms:identifier ?qid .
                FILTER (
                    !REGEX(STR(?id), CONCAT("^NFR-", STR(?qid), "-[0-9]+$"))
                    &&
                    !REGEX(STR(?id), CONCAT("^NFR-[A-Z0-9]+_", STR(?qid), "-[0-9]+$"))
                )
            }
        """ ;
    ] .

# ---------------------------------------------------------------------------------------------------
# B-4 (Table B; `generated` + `core`): every itpra:REQUIREMENT carries at least one itpra-o:metBy and at
# least one itpra-o:verifiedBy edge. The authoring schema closes this pre-emission, but that closure alone
# is too weak (fixtures/requirements/README.md): `emit.emit()` never calls the authoring validator
# (`itpra_onto.authoring.AuthoringValidator`) at all, so a record with an empty `met_by`/`verified_by`
# list that somehow reaches `emit()` -- bypassing `itpra-onto validate --authoring`, e.g. a hand-edited
# record, or a future non-YAML authoring path -- emits fine and would be invisible to `itpra-onto validate`
# (the SHACL command) too. These two shapes close that gap at the graph level (ADR 0042 D3: a shape may be
# stricter than the linter).
itpra-o:ReqMetByNonEmptyShape
    a sh:PropertyShape ;
    sh:targetClass itpra:REQUIREMENT ;
    sh:path itpra-o:metBy ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "a Requirement must carry at least one met_by edge (B-4)" ;
    itpra-o:ruleId "B-4" .

itpra-o:ReqVerifiedByNonEmptyShape
    a sh:PropertyShape ;
    sh:targetClass itpra:REQUIREMENT ;
    sh:path itpra-o:verifiedBy ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "a Requirement must carry at least one verified_by edge (B-4)" ;
    itpra-o:ruleId "B-4" .
