# Rule 20 — capability-in-service-domain.
#
# Roll-up: every Capability is `groupedBy` a Domain, and every Domain is `belongsToServiceDomain` a
# ServiceDomain (`belongs_to_service_domain` is mandatory, 1:1, on Domain). This rule flattens that
# path onto a direct `itpra-o:inServiceDomain` edge. Reads the asserted `t1` graph only.
#
# The PREFIX block (itpra:, itpra-o:, itpra-g:) is prepended at run time from `itpra-onto.toml`
# `[iri]` (ADR 0004) — this file names no base IRI and declares no PREFIX itself.

CONSTRUCT {
  ?cap itpra-o:inServiceDomain ?sd .
}
WHERE {
  GRAPH itpra-g:t1 {
    ?cap a itpra:CAPABILITY ;
         itpra-o:groupedBy ?domain .
    ?domain a itpra:DOMAIN ;
            itpra-o:belongsToServiceDomain ?sd .
    ?sd a itpra:SERVICE_DOMAIN .
  }
}
