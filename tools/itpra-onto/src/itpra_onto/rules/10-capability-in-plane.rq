# Rule 10 — capability-in-plane.
#
# Roll-up: every Capability is `groupedBy` a Domain, and every Domain is `groupedBy` a Plane
# (grouped_by cardinalities: Capability -> Domain and Domain -> Plane are both 1:1). This rule flattens
# the two-hop path onto a direct `itpra-o:inPlane` edge so a query does not have to know the
# intermediate Domain exists. Reads the asserted `t1` graph only. No reasoner: a plain property-path
# join, run once, in this stated order (ADR 0041 D4).
#
# The PREFIX block (itpra:, itpra-o:, itpra-g:) is prepended at run time from `itpra-onto.toml`
# `[iri]` (ADR 0004) — this file names no base IRI and declares no PREFIX itself.

CONSTRUCT {
  ?cap itpra-o:inPlane ?plane .
}
WHERE {
  GRAPH itpra-g:t1 {
    ?cap a itpra:CAPABILITY ;
         itpra-o:groupedBy ?domain .
    ?domain a itpra:DOMAIN ;
            itpra-o:groupedBy ?plane .
    ?plane a itpra:PLANE .
  }
}
